# Python bytecode and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
env/
venv/

# Logs and temporary run files
logs/
*.log
*.tmp*
.lock

# Operating system and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/

